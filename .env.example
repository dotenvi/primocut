# PRIMOCUT environment variables — copy to `.env` and fill in real values.
#
# `.env` is git-ignored and loaded automatically in development/test by
# dotenv-rails. Production supplies these through the real process environment,
# not a file.

# YouTube Data API v3 key (public data only). Used by Adapters::YoutubeApi.
# Create one at https://console.cloud.google.com/ → APIs & Services → Credentials.
YOUTUBE_API_KEY=

# Anthropic API key. Read by RubyLLM (config/initializers/ruby_llm.rb) for the
# opt-in LLM passes: macro topics (Cuts::Selection) and packaging of a cut.
# Create one at https://console.anthropic.com/ → API Keys.
ANTHROPIC_API_KEY=

# Transcription sidecar (Adapters::TranscriptionEngine). ENGINE_CMD is how Ruby
# invokes the `primocut-engine` Python sidecar — set it to the GPU venv's
# interpreter plus the script. The WHISPER_* knobs are optional overrides of the
# defaults baked into the adapter.
# ENGINE_CMD=/path/to/venv/bin/python sidecar/primocut_engine.py
# WHISPER_MODEL=large-v3-turbo
# WHISPER_LANGUAGE=pt
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16
# WHISPER_COMPUTE_FALLBACKS=float16,int8_float16,int8

# Clip render (Adapters::Ffmpeg). All optional — sensible defaults are baked in.
# RENDER_ENCODER picks the fine-cut encoder ("nvenc" | "libx264"); NVENC falls
# back to libx264 on its own when unavailable. FFPROBE_CMD mirrors FFMPEG_CMD.
# RENDER_ENCODER=nvenc
# RENDER_NVENC_CQ=19
# RENDER_X264_CRF=18
# RENDER_AUDIO_BITRATE=192k
# RENDER_SECTION_MARGIN_S=15
# EXPORT_UPSCALE_HEIGHT=1440
# FFPROBE_CMD=ffprobe
# CLIPS_DIR=clips      # where rendered clip MP4s land (Cuts::Render); default ./clips
# EXPORTS_DIR=exports  # where export bundles land (Cuts::Export); default ./exports

# Topic selection (Cuts::Selection). The transcript is windowed for the LLM MACRO
# pass; ENRICHMENT_MODEL (shared with enrichment) picks the model.
# WINDOW_TARGET_SECONDS=1200
# WINDOW_OVERLAP_SECONDS=60

# AI packaging of a cut (Cuts::PackagingService — opt-in). All optional.
# PACKAGING_TITLES_K=5
# PACKAGING_FRAMES_PER_CLIP=3
# PACKAGING_SCENE_THRESHOLD=0.30

# Postgres password — production only (development uses the docker-compose default).
# PRIMOCUT_DATABASE_PASSWORD=
