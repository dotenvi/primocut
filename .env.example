# PRIMOCUT environment variables — copy to `.env` and fill in real values.
#
# `.env` is git-ignored and loaded automatically in development/test by
# dotenv-rails. Production supplies these through the real process environment,
# not a file.

# YouTube Data API v3 key (public data only). Used by Adapters::YoutubeApi.
# Create one at https://console.cloud.google.com/ → APIs & Services → Credentials.
YOUTUBE_API_KEY=

# Transcription sidecar (Adapters::TranscriptionEngine). ENGINE_CMD is how Ruby
# invokes the `primocut-engine` Python sidecar — set it to the GPU venv's
# interpreter plus the script. The WHISPER_* knobs are optional overrides of the
# defaults baked into the adapter.
# ENGINE_CMD=/path/to/venv/bin/python sidecar/primocut_engine.py
# WHISPER_MODEL=large-v3-turbo
# WHISPER_LANGUAGE=pt
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16
# WHISPER_COMPUTE_FALLBACKS=float16,int8_float16,int8

# Postgres password — production only (development uses the docker-compose default).
# PRIMOCUT_DATABASE_PASSWORD=
