<% content_for :title, "#{@channel.title.presence || @channel.youtube_channel_id} — #{@project.name}" %>
<% ch = @dashboard[:channel] %>

<%= link_to "‹ Niche / Channels", project_niche_path(@project, tab: "channels"),
      class: "eyebrow cursor-pointer hover:text-ink-2 mb-2 block no-underline" %>

<div class="mb-5">
  <h1><%= ch[:title].presence || ch[:channel_id] %></h1>
  <p class="m mt-1">
    <% if ch[:handle].present? %><%= ch[:handle] %> · <% end %>
    <%= compact_number(ch[:subscribers]) %> subscribers ·
    <%= compact_number(ch[:total_views]) %> total views ·
    <%= ch[:video_count] || "—" %> videos
  </p>
</div>

<div class="grid grid-cols-2 gap-4 mb-6 max-[960px]:grid-cols-1">
  <div class="card">
    <div class="lbl mb-2">Baselines · median views</div>
    <% %w[long short].each do |f| %>
      <% b = @dashboard[:baselines][f] %>
      <div class="kv">
        <span><%= f == "long" ? "Long-form" : "Shorts" %></span>
        <span class="font-mono text-[12px]"><%= b ? "#{compact_number(b[:median])} · n=#{b[:sample]}" : "insufficient" %></span>
      </div>
    <% end %>
  </div>
  <div class="card">
    <div class="lbl mb-2">Engagement · median</div>
    <% eng = @dashboard[:engagement] %>
    <div class="kv">
      <span>Like rate</span>
      <span class="font-mono text-[12px]"><%= pct(eng["long"][:like_rate_median]) %> long · <%= pct(eng["short"][:like_rate_median]) %> short</span>
    </div>
    <div class="kv">
      <span>Comment rate</span>
      <span class="font-mono text-[12px]"><%= pct(eng["long"][:comment_rate_median]) %> long · <%= pct(eng["short"][:comment_rate_median]) %> short</span>
    </div>
  </div>
</div>

<% cad = @dashboard[:cadence] %>
<div class="lbl mb-2">Cadence · <%= format("%.1f", cad[:uploads_per_week]) %> uploads/week</div>
<% bars = MetricsHelper::WEEKDAYS.each_with_index.map { |label, i| [ label, cad[:by_weekday][i.to_s] || 0 ] } %>
<% max_weekday = [ 1, *bars.map { |_, c| c } ].max %>
<div class="flex items-end gap-1 h-20 mb-6">
  <% bars.each do |label, count| %>
    <div class="flex-1 flex flex-col items-center gap-1.5" title="<%= label %>: <%= count %>">
      <div class="w-full flex items-end h-16">
        <div class="w-full bg-[#3f4145] rounded-t-[2px]" style="height:<%= (count.to_f / max_weekday * 100).round %>%"></div>
      </div>
      <span class="font-mono text-[9px] text-ink-3"><%= label %></span>
    </div>
  <% end %>
</div>

<div class="flex items-center gap-3 mb-3">
  <span class="lbl">Outliers</span>
  <div class="flex gap-1.5">
    <% %w[long short].each do |f| %>
      <%= link_to project_niche_channel_path(@project, @channel.youtube_channel_id, fmt: f),
            class: class_names("chip no-underline", "on" => @fmt == f) do %>
        <%= f == "long" ? "Long" : "Shorts" %> <%= @dashboard[:outliers][f].length %>
      <% end %>
    <% end %>
  </div>
</div>

<% outliers = @dashboard[:outliers][@fmt] %>
<% if outliers.empty? %>
  <p class="m">No outlier in this format yet.</p>
<% else %>
  <table class="w-full border-collapse text-[13px]">
    <thead><tr>
      <th class="w-7 text-right">#</th><th>Video</th>
      <th class="text-right">Band</th><th class="text-right">× median</th><th class="text-right">Views</th>
    </tr></thead>
    <tbody>
      <% outliers.each_with_index do |o, i| %>
        <tr class="hover:bg-[#15181C]">
          <td class="text-right font-mono text-[12px] text-ink-3"><%= i + 1 %></td>
          <td>
            <%= o[:title].presence || o[:video_id] %>
            <% if o[:provisional] %><span class="m text-accent"> · provisional</span><% end %>
          </td>
          <td class="text-right">
            <% if o[:band] %><span class="tag bg-heat-bg99 text-heat-99 border-heat-ln99"><%= band_tag(o) %></span><% end %>
          </td>
          <td class="text-right font-mono text-[12px]"><%= multiplier(o[:median_multiple]) %></td>
          <td class="text-right font-mono text-[12px]"><%= compact_number(o[:views]) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
