<%#
  The pipeline panel for one source video: the stage rail, then the per-step log
  in canonical execution order (never raw history order) with each step's settled
  state and how long it took, plus a re-run.

  A step reads `complete` only when its artifact is actually there. One that
  produced nothing is `ignored` if the run entered it and `skipped` if it never
  did — two honest states the PoC learned to tell apart.
  Locals: row (a Sources::Screen::Row).
%>
<% steps = Pipeline::Steps.new(row.source_video) %>
<% log = steps.call %>

<aside id="pipeline_panel" class="w-[440px] shrink-0">
  <div class="card py-2.5">
    <div class="flex items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <span class="lbl">Pipeline</span>
        <div class="flex items-center">
          <% log.each_with_index do |step, i| %>
            <span class="st <%= step_lamp(step.state) %>" title="<%= step.label %>: <%= step.state %>"></span>
            <% if i < log.size - 1 %><span class="st-l"></span><% end %>
          <% end %>
        </div>
      </div>
      <% if row.rerunnable? %>
        <%= button_to "Rerun stages", project_rerun_source_path(@project, row.source_video),
              method: :post, class: "btn btn-xs" %>
      <% end %>
    </div>

    <div class="mt-2.5 border-t border-line pt-2.5">
      <% steps.warnings.each do |warning| %>
        <div class="m text-err mb-1.5">⚠ <%= warning %></div>
      <% end %>

      <% log.each do |step| %>
        <% status = step_status(step.state) %>
        <div class="flex items-center justify-between py-1.5 border-t border-line first:border-t-0">
          <span class="m text-ink-2"><%= step.label %></span>
          <div class="flex items-center gap-2.5">
            <span class="m text-ink-3 tabular-nums"><%= step_duration(step.duration_s) %></span>
            <span class="font-mono text-[11.5px] <%= status[:text] %> w-[76px] text-right"><%= status[:word] %></span>
            <span class="inline-flex items-center justify-center w-4 h-4 rounded-full text-[9px] leading-none font-bold shrink-0 <%= status[:ring] %>"
                  title="<%= status[:word] %>"><%= status[:glyph] %></span>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</aside>
