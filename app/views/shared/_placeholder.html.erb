<%#
  Phase-1 shell placeholder. The navigation and design system are real; each
  screen's content lands in Phase 2 (Niche & metrics) and beyond. Locals:
    eyebrow: small uppercase label above the title
    title:   screen name
    note:    one line on what will live here
%>
<header class="mb-6">
  <div class="eyebrow mb-1"><%= eyebrow %></div>
  <h1><%= title %></h1>
</header>

<div class="card flex items-start gap-3 max-w-[560px]">
  <span class="text-accent text-[18px] leading-none">&#9639;</span>
  <div>
    <div class="text-ink font-medium mb-1"><%= title %> &mdash; coming in Phase 2</div>
    <p class="text-ink-2 text-[13px] leading-relaxed m-0"><%= note %></p>
  </div>
</div>
