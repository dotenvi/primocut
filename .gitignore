# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files, except the committed template.
/.env*
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# --- PRIMOCUT ---------------------------------------------------------------

# Agent harness local state.
/.claude/

# Python GPU sidecar: its own venv and bytecode never belong in the repo.
/sidecar/.venv/
__pycache__/
*.pyc

# Runtime deliverables (rendered clips + export bundles). Large, regenerable,
# and per-machine — see PRIMOCUT_CLIPS_DIR / PRIMOCUT_EXPORTS_DIR.
/clips/
/exports/

# Media artifacts from local runs.
*.wav
*.m4a
*.mp3
*.mp4

# Node (only if a JS toolchain is added later).
/node_modules/

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep
